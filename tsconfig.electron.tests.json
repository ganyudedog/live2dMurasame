{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.electron.tests.tsbuildinfo",
    "useDefineForClassFields": false,
    "types": ["node", "vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true
  },
  "include": ["electron/**/*.ts", "electron/**/*.mts", "src", "plugins"]
}
