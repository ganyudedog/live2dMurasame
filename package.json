{
  "name": "live2d-murasame",
  "private": true,
  "version": "0.1.0",
  "description": "丛雨 Live2D 桌宠",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "eval": "node eval/run.mjs",
    "eval:benchmark": "node eval/run.mjs --benchmark",
    "eval:draft": "node --experimental-strip-types eval/draft.ts",
    "test:plugin-sdk": "pnpm build && node plugins/sdk/test/acceptance.mjs",
    "build:plugins": "tsc -p plugins/sdk/tsconfig.json && node scripts/build-plugin-ui.mjs",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.electron.tests.json --pretty false",
    "dev": "vite",
    "build": "pnpm build:plugins && tsc -b && vite build && pnpm electron:compile",
    "package:client": "node scripts/package-client.mjs",
    "test": "pnpm electron:compile && tsc -p test/tsconfig.json --noEmit --pretty false && vitest run",
    "electron:dev": "pnpm build:plugins && pnpm electron:compile && set VITE_DEV_SERVER_URL=http://localhost:5180&& node --env-file=.env.development --env-file=infra/jaeger/dev.env node_modules/electron/cli.js ./dist-electron/main.js",
    "lint": "eslint .",
    "check:boundaries": "node --env-file=scripts/knip.env node_modules/knip/bin/knip.js --no-progress && node scripts/checkRetiredEntries.mjs",
    "prepare": "husky",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.32",
    "@tanstack/react-query": "^5.96.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.8.3",
    "koffi": "^3.2.1",
    "livekit-client": "^2.18.1",
    "lucide-react": "^1.70.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mobx": "^7.0.3",
    "mobx-react-lite": "^5.0.3",
    "openai": "^6.27.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "7.3.3",
    "radix-ui": "^1.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@tailwindcss/vite": "^4.2.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^44.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "26.1.0",
    "knip": "^6.45.1",
    "promptfoo": "0.118.0",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "gh-pages": "^6.3.0"
  },
  "pnpm": {
    "overrides": {
      "boolean": "latest",
      "gh-pages": "^6.3.0"
    },
    "onlyBuiltDependencies": [
      "electron",
      "better-sqlite3",
      "esbuild",
      "@esbuild/*"
    ]
  }
}
