{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["plugins/**"],
  "workspaces": {
    ".": {
      "entry": [
        "index.html",
        "electron/preload.mts",
        "electron/tests/preloadSmoke.mjs",
        "scripts/**/*.mjs"
      ],
      "project": ["src/**", "electron/**", "shared/**", "scripts/**"]
    }
  },
  "ignore": [
    "shared/**/*.d.ts",
    "src/app/modules/ai/modules/asr/domain/audio.ts",
    "src/app/modules/ai/modules/llm/domain/rag/retriever.ts",
    "src/app/modules/ai/modules/tts/index.ts",
    "src/app/modules/live2d/modules/interaction/domain/dragHandle/dragHandleEngine.ts"
  ],
  "ignoreBinaries": ["tar.exe", "icacls.exe"],
  "ignoreDependencies": [
    "electron-store",
    "electron-updater"
  ],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "duplicates": "off",
    "enumMembers": "off"
  }
}
